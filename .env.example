PMS_SECRET_KEY=replace-with-a-generated-secret-key
PMS_DEBUG=True
PMS_ALLOWED_HOSTS=localhost,127.0.0.1

PMS_DB_NAME=pms
PMS_DB_USER=pms_app
PMS_DB_PASSWORD=replace-with-your-database-password
PMS_DB_HOST=127.0.0.1
PMS_DB_PORT=5432

# Set these for registration, password reset and verified email changes in deployment.
# Locally the default backend prints email to the runserver console.
PMS_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
PMS_EMAIL_HOST=smtp.example.com
PMS_EMAIL_PORT=587
PMS_EMAIL_HOST_USER=replace-with-smtp-username
PMS_EMAIL_HOST_PASSWORD=replace-with-smtp-password
PMS_EMAIL_USE_TLS=True
PMS_EMAIL_USE_SSL=False
PMS_DEFAULT_FROM_EMAIL=noreply@example.com
